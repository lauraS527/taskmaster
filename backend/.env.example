PORT=3000

# Base de datos. En tu computador: localhost y el puerto 3306.
# En la nube: los datos que entrega el servicio (host, puerto, usuario, contraseña).
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=taskmaster

# Solo en la nube: conexión cifrada (true). DB_SSL_CA es opcional (certificado del servidor).
DB_SSL=
DB_SSL_CA=

# Secreto para firmar los tokens: largo, aleatorio y distinto en cada entorno
JWT_SECRET=

# Dirección exacta del frontend, sin barra final (por ejemplo https://tuapp.vercel.app)
CLIENT_URL=http://localhost:5173

# Correo (buzón de pruebas de Mailtrap)
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
